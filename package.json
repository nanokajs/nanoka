{
  "name": "nanoka-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:pack": "node --test scripts/package-bin.test.mjs",
    "security:report": "node scripts/collect-security-report.mjs",
    "test:security-report": "node --test scripts/collect-security-report.test.mjs",
    "test:workerd-rpc": "node --test scripts/workerd-rpc-security.test.mjs",
    "test:workerd-streams": "node --test scripts/workerd-stream-security.test.mjs",
    "test:workerd-websocket": "node --test scripts/workerd-websocket-lifetime.test.mjs",
    "test:workerd-d1": "node --test scripts/workerd-d1-security.test.mjs",
    "test:undici-integrity": "node --test scripts/undici-integrity-security.test.mjs",
    "test:wrangler-assets": "node --test scripts/wrangler-assets-security.test.mjs"
