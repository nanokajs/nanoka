      "vitest@>=4.1.0 <4.1.12": "4.1.12",
      "postcss@>=8.0.0 <8.5.23": "8.5.28",
      "nanoid@>=3.0.0 <3.3.18": "3.3.19",
      "fflate@>=0.7.0 <0.7.5": "0.7.5",
      "miniflare>sharp": "0.35.5",
      "zod@>=4.0.0 <4.6.6": "4.6.7",
      "workerd@>=1.0.0 <1.20261107.1": "1.20261107.1",
      "wrangler@>=4.0.0 <4.158.0": "4.158.0"
    }
  }
